# Google Cloud & Vertex AI Configuration (Managed via GCP Secret Manager in Production)
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=TRUE

# Secret Manager Secret IDs (No hardcoded API keys in source code)
GEMINI_API_KEY_SECRET_ID=md-supply-demand-gemini-api-key
GEMINI_API_KEY=

# Model Routing Configuration
MD_ROUTER_FAST_MODEL=gemini-2.5-flash
MD_SYNTHESIS_PRO_MODEL=gemini-2.5-pro

# Persistent Storage & Telemetry
MD_SQLITE_DB_PATH=supply_demand_state.db
OTEL_SERVICE_NAME=md-supply-vs-demand-agent
PORT=8080
